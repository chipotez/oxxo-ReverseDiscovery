FROM docker.io/library/node:22-alpine AS flow-build
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/src/ ./src/
RUN npm run build

FROM docker.io/library/python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.lock .
RUN pip install --no-cache-dir -r requirements.lock && useradd --uid 1000 --create-home koodaria && mkdir /app/sessions && chown 1000:1000 /app/sessions
COPY --chown=1000:1000 server.py diagrams.py diagram_pdf.py access.py invitations.py test_server.py test_diagrams.py test_sharing.py ./
COPY --chown=1000:1000 templates/ ./templates/
COPY --chown=1000:1000 static/ ./static/
COPY --from=flow-build --chown=1000:1000 /ui/dist/ ./static/
USER 1000:1000
EXPOSE 8000
CMD ["gunicorn","--bind","0.0.0.0:8000","--workers","2","--threads","2","--timeout","30","--error-logfile","-","server:app"]
