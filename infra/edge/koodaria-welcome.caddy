# Replace the existing koodaria.com block with this site. Preserve other domains.
koodaria.com {
  @koodariaLogin path /login /login/
  redir @koodariaLogin /auth/login 302
  @workspace path /auth/* /bienvenida /bienvenida/* /workspace-assets/*
  handle @workspace {
    header {
      Cache-Control "no-store"
      Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self' https://login.koodaria.com/realms/koodaria/protocol/openid-connect/logout; frame-ancestors 'none'"
      Referrer-Policy "no-referrer"
    }
    reverse_proxy koodaria-workspace:8000 {
      header_up Host koodaria.com
    }
  }
  handle {
    root * /srv/koodaria
    encode zstd gzip
    file_server
    header {
      Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
      Cache-Control "no-cache"
      Referrer-Policy "strict-origin-when-cross-origin"
    }
  }
  log_skip /auth/*
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    -Server
  }
  log {
    output stdout
    format json
  }
}

# Inside login.koodaria.com:
# redir / https://koodaria.com/auth/login 302
# log_skip /realms/koodaria/protocol/openid-connect/logout
